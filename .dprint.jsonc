{
    "yaml": {
        "printWidth": 100,
        "formatComments": true,
        "braceSpacing": false,
    },
    "excludes": [
        "**/*-lock.json",
        "**/*.lock",
        "**/node_modules/",
        "dist/",
        // Verbatim copies of upstream conda-lock/CEP-37 files; reformatting
        // them would break what the compatibility tests are asserting.
        "test-data/cep37/",
    ],
    "plugins": [
        "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.5.1.wasm",
    ],
}
