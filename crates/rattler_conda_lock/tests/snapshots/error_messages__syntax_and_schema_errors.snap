---
source: crates/rattler_conda_lock/tests/error_messages.rs
expression: report_all
---
# not yaml
kind:    Syntax { message: "unclosed bracket '[' at line 1, column 11" }
display: unclosed bracket '[' at line 1, column 11
label:   <document> [<primary>] <no span>

# two documents
kind:    MultipleDocuments
display: a lock file must contain exactly one YAML document
label:   <document> [<primary>] ""

# duplicate mapping key
kind:    DuplicateKey { key: "sources" }
display: metadata.sources: duplicate mapping key "sources"
label:   metadata.sources [<primary>] "sources"
label:   metadata.sources [first defined here] "sources"

# missing field
kind:    MissingField { field: "sources" }
display: metadata.sources: missing required field "sources"
label:   metadata.sources [<primary>] "metadata"

# unknown field
kind:    UnknownField { field: "future" }
display: metadata.future: unknown field "future"
label:   metadata.future [<primary>] "true"

# unsupported version
kind:    UnsupportedVersion
display: version: unsupported lock-file version; expected integer 1
label:   version [<primary>] "2"

# expected a mapping
kind:    UnexpectedType(Mapping)
display: package[0]: expected a mapping
label:   package[0] [<primary>] "just-a-string"

# expected a sequence
kind:    UnexpectedType(Sequence)
display: metadata.channels: expected a sequence
label:   metadata.channels [<primary>] "{"

# expected a string
kind:    UnexpectedType(String)
display: metadata.platforms[0]: expected a string
label:   metadata.platforms[0] [<primary>] "["

# expected a boolean
kind:    UnexpectedType(Boolean)
display: package[0].optional: expected a boolean
label:   package[0].optional [<primary>] "maybe"

# unknown manager
kind:    UnknownManager { found: "cargo" }
display: package[0].manager: unknown package manager "cargo"; expected "conda" or "pip"
label:   package[0].manager [<primary>] "cargo"

# unsupported source type
kind:    UnsupportedSourceType { found: "git" }
display: package[0].source.type: unsupported package source type "git"; expected "url"
label:   package[0].source.type [<primary>] "git"
