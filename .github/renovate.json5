{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:best-practices"],
  enabledManagers: ["github-actions", "pixi", "cargo", "npm", "custom.regex"],
  commitMessagePrefix: "chore(ci):",
  ignorePaths: ["**/test-data/**"],
  labels: ["dependencies"],
  schedule: ["before 4am"],
  prHourlyLimit: 10,
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 4am"],
  },
  cargo: {
    // See https://docs.renovatebot.com/configuration-options/#rangestrategy
    rangeStrategy: "update-lockfile",
  },
  packageRules: [
    {
      description: "Annotate GitHub Actions SHAs with a SemVer version.",
      extends: ["helpers:pinGitHubActionDigests"],
      extractVersion: "^(?<version>v?\\d+\\.\\d+\\.\\d+)$",
      versioning: "regex:^v?(?<major>\\d+)(\\.(?<minor>\\d+)\\.(?<patch>\\d+))?$",
    },
    {
      description: "Automerge non-major dependency updates after CI passes.",
      matchUpdateTypes: ["digest", "pinDigest", "patch", "minor", "lockFileMaintenance"],
      automerge: true,
    },
    {
      description: "We want to update Rust manually and keep it in sync with rust-toolchain",
      matchPackageNames: "rust",
      matchManagers: ["pixi"],
      enabled: false,
    },
    {
      description: "Wait 14 days after a release before proposing an update. Overrides the shorter npm default from config:best-practices.",
      matchPackageNames: ["*"],
      minimumReleaseAge: "14 days",
    },
    {
      description: "The getrandom_v03 alias in js-rattler only enables the `wasm_js` feature for transitive getrandom 0.3 dependencies (e.g. ahash), so it must stay on 0.3.",
      matchManagers: ["cargo"],
      matchDepNames: ["getrandom_v03"],
      allowedVersions: "<0.4",
    },
    {
      description: "pyo3-ffi links the native Python library, so a build can contain only one pyo3 version. Crates that depend on pyo3 must therefore be updated together.",
      matchManagers: ["cargo", "custom.regex"],
      matchPackageNames: ["pyo3", "pyo3-*", "pythonize"],
      groupName: "pyo3",
    },
    {
      description: "Every pyo3-dependent crate needs the same pyo3 series, and pythonize is usually the last to support a new one. pyo3 and pyo3-async-runtimes follow pythonize releases (see customManagers). pyo3-file uses its own numbering, so it cannot follow pythonize; bump it by hand in the pyo3 group PR. Patch updates within the current series still go through.",
      matchManagers: ["cargo"],
      matchPackageNames: ["pyo3", "pyo3-async-runtimes", "pyo3-file"],
      matchUpdateTypes: ["major", "minor"],
      enabled: false,
    },
  ],
  customManagers: [
    {
      description: "pythonize X.Y requires pyo3 X.Y and is usually released after pyo3. Take the pyo3 and pyo3-async-runtimes series from pythonize releases so the pyo3 group only moves once pythonize supports the new pyo3.",
      customType: "regex",
      managerFilePatterns: ["/^py-rattler/Cargo\\.toml$/"],
      matchStrings: ["\\n(?<depName>pyo3|pyo3-async-runtimes) = \\{ version = \"(?<currentValue>[^\"]+)\""],
      packageNameTemplate: "pythonize",
      datasourceTemplate: "crate",
      versioningTemplate: "cargo",
    },
  ],
  vulnerabilityAlerts: {
    commitMessageSuffix: "",
    labels: ["security"],
  },
}
